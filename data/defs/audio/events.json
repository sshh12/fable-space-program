      "structureBorne": false,
      "refDistance": 40,
      "minInterval": 0.2,
      "maxVoices": 3,
      "rate": [0.92, 1.04],
      "scaleBy": { "field": "energy", "ref": 1000000000, "exponent": 0.5, "minDb": -20, "maxDb": 10 }
    }
  }
